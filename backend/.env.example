# -----------------------------------------------------------------------------
# AirSentinel Backend Environment Variables
# Copy this file to backend/.env and fill in your credentials
# -----------------------------------------------------------------------------

# PostgreSQL / PostGIS Database connection string (Supabase or local PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:your-db-password@db.your-supabase-project.supabase.co:5432/postgres

# Supabase Project URL (for JWT validation and user authentication)
SUPABASE_URL=https://your-supabase-project.supabase.co

# WAQI (World Air Quality Index) API Token (free from https://aqicn.org/data-platform/token/)
WAQI_API_TOKEN=your_waqi_api_token_here

# OpenAQ API Key (free from https://openaq.org/)
OPENAQ_API_KEY=your_openaq_api_key_here

# OpenWeatherMap API Key (free from https://openweathermap.org/api)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Google Gemini API Key (for AI Environmental Intelligence briefing, from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Central Pollution Control Board (CPCB / data.gov.in) API Key
CPCB_API_KEY=your_cpcb_api_key_here

# Optional: IQAir AirVisual API Key
IQAIR_API_KEY=your_iqair_api_key_here
